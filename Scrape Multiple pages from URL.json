    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Process each crawled page data\nconst pageData = $input.item.json;\n\n// Return the extracted data directly\nreturn {\n  URL: pageData.metadata?.sourceURL || pageData.metadata?.url || '',\n  Title: pageData.metadata?.title || '',\n  'Meta Description': pageData.metadata?.description || pageData.metadata?.ogDescription || '',\n  'Content / Body Text': pageData.markdown || pageData.content || ''\n};"
      },
      "id": "c0840391-26fa-41fc-bb87-edee6a5b6306",
      "name": "Process Page Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        32
      ],
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "// Extract the data array from Firecrawl response\nconst response = $input.first().json;\n\n// The response is an array with one object containing the data\nconst crawlResult = Array.isArray(response) ? response[0] : response;\n\n// Return the data array\nreturn crawlResult.data.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        32
      ],
      "id": "4c06c780-7b19-46ac-a126-925d55f34aee",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Format all page data for Google Docs\nconst items = $input.all();\n\n// Build a well-structured document\nlet documentContent = '# One Health Assist - Website Content\\n\\n';\ndocumentContent += `Total Pages Scraped: ${items.length}\\n`;\ndocumentContent += `Generated on: ${new Date().toLocaleString()}\\n\\n`;\ndocumentContent += '---\\n\\n';\n\nitems.forEach((item, index) => {\n  const data = item.json;\n  \n  documentContent += `## Page ${index + 1}\\n\\n`;\n  documentContent += `**URL:** ${data.URL}\\n\\n`;\n  documentContent += `**Title:** ${data.Title}\\n\\n`;\n  \n  if (data['Meta Description']) {\n    documentContent += `**Meta Description:** ${data['Meta Description']}\\n\\n`;\n  }\n  \n  documentContent += `**Content:**\\n\\n${data['Content / Body Text']}\\n\\n`;\n  documentContent += '---\\n\\n';\n});\n\nreturn {\n  documentContent: documentContent,\n  title: `OneHealthAssist_Scraped_${new Date().toISOString().split('T')[0]}`\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        32
      ],
      "id": "a1746c11-6edf-4059-82d0-fa2efd059590",
      "name": "Format for Google Docs"
