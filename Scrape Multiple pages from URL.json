    {
      "parameters": {
        "jsCode": "// Handle failed crawl - extract error information\nconst response = $input.first().json;\n\nconst errorInfo = {\n  status: response.status || 'unknown',\n  message: response.error || 'Crawl did not complete successfully',\n  current: response.current || 0,\n  total: response.total || 0,\n  creditsUsed: response.creditsUsed || 0,\n  expiresAt: response.expiresAt || '',\n  data: response.data || []\n};\n\n// If there's partial data, we can still process it\nif (errorInfo.data && errorInfo.data.length > 0) {\n  return {\n    hasPartialData: true,\n    ...errorInfo\n  };\n}\n\n// Otherwise, return error information\nreturn {\n  hasPartialData: false,\n  ...errorInfo\n};"
      },
      "id": "d2cb9afb-4f90-47de-a63f-f723d36b4774",
