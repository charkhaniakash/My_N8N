      "name": "Extract Email Data (DeepSeek)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        832,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst content = response.candidates[0].content.parts[0].text;\n\n// Log the actual content to see what we're dealing with\nconsole.log('Raw content:', content);\n\n// Find the first { and last }\nconst startIndex = content.indexOf('{');\nconst endIndex = content.lastIndexOf('}');\n\nconsole.log('Start index:', startIndex);\nconsole.log('End index:', endIndex);\nconsole.log('Extracted:', content.substring(startIndex, endIndex + 1));\n\nconst jsonString = content.substring(startIndex, endIndex + 1);\nconst emailData = JSON.parse(jsonString);\n\nreturn {\n  json: emailData\n};"
      },
      "id": "0a20aebf-4e65-4801-936a-aa2e60230193",
