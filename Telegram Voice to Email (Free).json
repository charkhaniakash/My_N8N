    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst optimizedBody = response.candidates[0].content.parts[0].text.trim();\nconst emailData = $node[\"Parse Email Data\"].json;\n\nreturn {\n  json: {\n    to: emailData.to,\n    subject: emailData.subject,\n    body: optimizedBody,\n    chatId: emailData.chatId\n  }\n};"
      },
