        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"You are an email data extractor. Extract the email information from this voice transcription and return ONLY a valid JSON object with these fields:\\n\\n{\\n  \\\"to\\\": \\\"recipient email address\\\",\\n  \\\"subject\\\": \\\"email subject\\\",\\n  \\\"body\\\": \\\"email message body\\\"\\n}\\n\\nIMPORTANT: \\n- Return ONLY the JSON object, no other text before or after\\n- If the user says 'at' or 'dot', convert to @ and . symbols\\n- Example: 'john at gmail dot com' becomes 'john@gmail.com'\\n\\nTranscription: {{ $json.message.text }}\\n\\nReturn only valid JSON:\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "3b32e5ea-1d42-48ec-8681-7d61b34886b4",
