        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"You are a professional email writer. Rewrite the following email to be clear, concise, professional, and well-structured:\\n\\n{{ $json.body }}\"\n        }\n      ]\n    }\n  ]\n}\n",
